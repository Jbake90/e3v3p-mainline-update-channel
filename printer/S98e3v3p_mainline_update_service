#!/bin/sh
set -eu

CONTROLLER=/usr/data/e3v3p-update-controller
RUNNER=$CONTROLLER/printer/deploy.sh
PID=/var/run/e3v3p_mainline_update.pid
LOG=/usr/data/e3v3p-update-state/launcher.log

start_update() {
    [ -x "$RUNNER" ] || return 1
    if [ -r "$PID" ]; then
        oldpid=$(sed -n '1p' "$PID")
        case "$oldpid" in ''|*[!0-9]*) ;; *) kill -0 "$oldpid" 2>/dev/null && return 0 ;; esac
    fi
    mkdir -p /usr/data/e3v3p-update-state
    start-stop-daemon -S -q -b -m -p "$PID" \
        --exec /bin/sh -- "$RUNNER" >> "$LOG" 2>&1
}

stop_update() {
    [ -r "$PID" ] || return 0
    pid=$(sed -n '1p' "$PID")
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || { rm -f "$PID"; return 0; }
    kill "$pid"
    rm -f "$PID"
}

case "${1:-}" in
    start) start_update ;;
    stop) stop_update ;;
    restart|reload) stop_update && start_update ;;
    *) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
esac
